@echo off
chcp 65001 > nul
setlocal

echo ========================================================
echo   RSS Curator - 手動更新 ^& GitHub プッシュ
echo ========================================================
echo.

cd /d "%~dp0"

echo [実行中] フィード巡回・関心スコアリング・XML生成・GitHubプッシュ...
uv run python -m src.main --run --push

if %ERRORLEVEL% equ 0 (
    echo.
    echo ========================================================
    echo   [完了] フィードの更新とGitHubプッシュが完了しました！
    echo   Feedly等のリーダーで1〜2分後に最新記事が反映されます。
    echo ========================================================
) else (
    echo.
    echo ========================================================
    echo   [エラー] 処理中にエラーが発生しました。
    echo ========================================================
)

echo.
pause
